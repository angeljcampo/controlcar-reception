<%# Each AgentRun is a <details> block: click on the row to expand and see
    the chronological log of LLM responses + tool calls captured during
    the run. Older runs without raw_log show a placeholder. %>
<li class="group">
  <details class="border-b border-outline-variant last:border-b-0">
    <summary class="flex items-start gap-3 py-3 px-1 cursor-pointer hover:bg-surface-container-low rounded-md transition list-none">
      <div class="flex-shrink-0 mt-0.5">
        <%= agent_run_status_icon(run) %>
      </div>

      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-body-md font-medium text-on-surface"><%= run.ai_model.presence || "—" %></span>
            <span class="text-body-sm text-on-surface-variant truncate"><%= run.agent_name.demodulize %></span>
          </div>
          <span class="text-body-sm text-on-surface-variant flex-shrink-0">
            <%= l(run.created_at, format: :short) %>
          </span>
        </div>

        <div class="flex items-center gap-3 text-body-sm text-on-surface-variant mt-1 flex-wrap">
          <span><%= (run.input_tokens.to_i + run.output_tokens.to_i) %> tokens</span>
          <span aria-hidden="true">·</span>
          <span><%= format_cents(run.cost_cents) %></span>
          <span aria-hidden="true">·</span>
          <span><%= run.latency_ms.to_i %> ms</span>
          <% if run.error_message.present? %>
            <span aria-hidden="true">·</span>
            <span class="text-red-600 truncate"><%= truncate(run.error_message, length: 60) %></span>
          <% end %>
        </div>
      </div>

      <%# Chevron — rotates when <details> is open. %>
      <span class="material-symbols-outlined text-on-surface-variant text-[20px] mt-0.5 group-open:rotate-180 transition-transform">expand_more</span>
    </summary>

    <%# Expanded detail body ─────────────────────────────────────── %>
    <div class="px-1 pb-4 pt-1">
      <% if run.error_message.present? %>
        <div class="mb-3 bg-red-50 border border-red-200 rounded-lg p-3">
          <div class="text-label-md uppercase text-red-700 mb-1">Error</div>
          <pre class="text-body-sm text-red-900 font-mono whitespace-pre-wrap break-words"><%= run.error_message %></pre>
        </div>
      <% end %>

      <% if run.raw_log.present? %>
        <div class="space-y-2">
          <% run.raw_log.each_with_index do |entry, i| %>
            <%= render_log_entry(entry, i) %>
          <% end %>
        </div>
      <% else %>
        <p class="text-body-sm text-on-surface-variant italic py-2">
          Sin detalle capturado (corrida anterior a la grabación de raw_log).
        </p>
      <% end %>
    </div>
  </details>
</li>
