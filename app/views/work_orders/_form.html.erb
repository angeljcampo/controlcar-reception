<%= form_with model: work_order, multipart: true, class: "space-y-6 bg-white p-6 rounded-lg border border-zinc-200 shadow-sm" do |f| %>
  <% if work_order.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <h3 class="text-sm font-medium text-red-800 mb-2">
        <%= t(".errors_heading", count: work_order.errors.count) %>
      </h3>
      <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
        <% work_order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :patente, class: "block text-sm font-medium text-zinc-700 mb-1" %>
      <%= f.text_field :patente,
                       value: work_order.patente || work_order.vehicle&.patente,
                       placeholder: t(".patente_placeholder"),
                       autofocus: true,
                       class: "block w-full rounded-md border-zinc-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 font-mono uppercase" %>
    </div>

    <div>
      <%= f.label :customer_name, class: "block text-sm font-medium text-zinc-700 mb-1" %>
      <%= f.text_field :customer_name,
                       class: "block w-full rounded-md border-zinc-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :mileage, class: "block text-sm font-medium text-zinc-700 mb-1" %>
      <%= f.number_field :mileage,
                         min: 0,
                         class: "block w-full rounded-md border-zinc-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :priority, class: "block text-sm font-medium text-zinc-700 mb-1" %>
      <%= f.select :priority,
                   WorkOrder::PRIORITIES.map { |p| [t("enums.work_order.priority.#{p}"), p] },
                   { include_blank: false },
                   class: "block w-full rounded-md border-zinc-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= f.label :reason, class: "block text-sm font-medium text-zinc-700 mb-1" %>
    <%= f.text_area :reason,
                    rows: 4,
                    placeholder: t(".reason_placeholder"),
                    class: "block w-full rounded-md border-zinc-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <p class="text-xs text-zinc-500 mt-1"><%= t(".reason_hint") %></p>
  </div>

  <div>
    <%= f.label :photos, class: "block text-sm font-medium text-zinc-700 mb-1" %>
    <%= f.file_field :photos,
                     multiple: true,
                     accept: "image/*",
                     class: "block w-full text-sm text-zinc-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-zinc-100 file:text-zinc-700 hover:file:bg-zinc-200" %>
    <p class="text-xs text-zinc-500 mt-1"><%= t(".photos_hint") %></p>
  </div>

  <div class="flex items-center justify-end space-x-3 pt-4 border-t border-zinc-200">
    <%= link_to t(".cancel"), work_orders_path, class: "px-4 py-2 text-sm font-medium text-zinc-700 hover:text-zinc-900" %>
    <%= f.submit class: "inline-flex items-center px-4 py-2 rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm cursor-pointer" %>
  </div>
<% end %>
