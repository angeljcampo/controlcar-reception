<%# Form card aligned with the Stitch MD3 reference. Inputs use the
    surface-container-low fill + outline-variant border treatment, and
    the file_field is layered as an invisible overlay on a styled
    dropzone so clicking anywhere on the zone opens the file picker. %>
<%= form_with model: work_order,
              multipart: true,
              class: "space-y-10 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant p-6 lg:p-10" do |f| %>
  <% if work_order.errors.any? %>
    <div class="bg-error-container border border-error/30 rounded-lg p-4">
      <h3 class="text-label-md font-semibold text-on-error-container mb-2 uppercase tracking-wider">
        <%= t(".errors_heading", count: work_order.errors.count) %>
      </h3>
      <ul class="text-body-sm text-on-error-container list-disc list-inside space-y-1">
        <% work_order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Priority is intentionally NOT in the form: the LLM owns that field.
      The job updates WorkOrder.priority from the analysis once it runs. %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8">
    <div class="space-y-3">
      <%= f.label :patente, class: "block text-label-md text-on-surface-variant uppercase tracking-wider" %>
      <%= f.text_field :patente,
                       value: work_order.patente || work_order.vehicle&.patente,
                       placeholder: t(".patente_placeholder"),
                       autofocus: true,
                       class: "w-full h-12 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-4 focus:ring-primary/15 focus:border-primary outline-none transition text-body-md placeholder:text-outline/60 font-mono uppercase" %>
    </div>

    <div class="space-y-3">
      <%= f.label :mileage, class: "block text-label-md text-on-surface-variant uppercase tracking-wider" %>
      <div class="relative">
        <%= f.number_field :mileage,
                           min: 0,
                           placeholder: t(".mileage_placeholder"),
                           class: "w-full h-12 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-4 focus:ring-primary/15 focus:border-primary outline-none transition text-body-md placeholder:text-outline/60" %>
      </div>
    </div>

    <div class="md:col-span-2 space-y-3">
      <%= f.label :customer_name, class: "block text-label-md text-on-surface-variant uppercase tracking-wider" %>
      <%= f.text_field :customer_name,
                       placeholder: t(".customer_name_placeholder"),
                       class: "w-full h-12 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-4 focus:ring-primary/15 focus:border-primary outline-none transition text-body-md placeholder:text-outline/60" %>
    </div>
  </div>

  <div class="space-y-3">
    <%= f.label :reason, class: "block text-label-md text-on-surface-variant uppercase tracking-wider" %>
    <%= f.text_area :reason,
                    rows: 5,
                    placeholder: t(".reason_placeholder"),
                    class: "w-full p-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-4 focus:ring-primary/15 focus:border-primary outline-none transition text-body-md placeholder:text-outline/60 resize-none" %>
    <p class="text-body-sm text-on-surface-variant italic"><%= t(".reason_hint") %></p>
  </div>

  <div class="space-y-3">
    <label for="work_order_photos" class="block text-label-md text-on-surface-variant uppercase tracking-wider">
      <%= t("helpers.label.work_order.photos") %>
    </label>
    <%# Compact horizontal dropzone. The file_field is `hidden` and the
        wrapping <label[for]> triggers the picker — simpler than an
        absolute overlay and immune to z-index quirks. %>
    <label for="work_order_photos"
           class="flex items-center gap-6 border border-dashed border-outline-variant rounded-2xl px-6 py-5 bg-surface-container-low hover:bg-surface-container-high hover:border-primary/50 transition-colors cursor-pointer group">
      <div class="shrink-0 w-12 h-12 rounded-xl bg-secondary-container text-on-secondary-fixed flex items-center justify-center group-hover:bg-secondary-fixed-dim transition-colors">
        <span class="material-symbols-outlined text-[24px] leading-none" style="font-variation-settings: 'FILL' 1;">add_a_photo</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-body-md font-semibold text-on-surface"><%= t(".upload.title") %></p>
        <p class="text-body-sm text-on-surface-variant truncate mt-0.5"><%= t(".upload.subtitle") %></p>
      </div>
      <span class="hidden sm:inline-flex shrink-0 text-body-sm font-semibold text-primary items-center gap-1 group-hover:gap-2 transition-all">
        <%= t(".upload.browse") %>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </span>
    </label>
    <%= f.file_field :photos, multiple: true, accept: "image/*", class: "hidden" %>
    <p class="text-body-sm text-on-surface-variant italic"><%= t(".photos_hint") %></p>
  </div>

  <div class="flex items-center justify-end gap-3 pt-6 border-t border-outline-variant">
    <%= link_to t(".cancel"), work_orders_path,
                class: "inline-flex items-center px-5 py-2.5 text-body-md font-medium text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors" %>
    <%= f.button class: "inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-on-primary text-body-md font-semibold rounded-full shadow-sm hover:bg-primary-container hover:shadow transition-all active:scale-[0.98] cursor-pointer" do %>
      <%= t("helpers.submit.work_order.#{work_order.persisted? ? 'update' : 'create'}") %>
    <% end %>
  </div>
<% end %>
