<%# Garage theme (dark) form — Claude Design handoff. All styling lives in
    application.css under the `.wof-*` selectors, scoped by the wrapping
    `.wof` div in new.html.erb. The Rails wiring (form_with, file_field,
    Stimulus vehicle-lookup) is unchanged — only the structure +
    presentation match the design. %>
<%= form_with model: work_order,
              multipart: true,
              data: { controller: "vehicle-lookup" } do |f| %>

  <%# Validation errors — only visible on re-render after a failed POST.
      Styled to match the Garage theme (danger color + soft red bg). %>
  <% if work_order.errors.any? %>
    <div class="wof-errors">
      <h3><%= t(".errors_heading", count: work_order.errors.count) %></h3>
      <ul>
        <% work_order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── Vehicle-found banner ───────────────────────────────────────
      Hidden by default. The Stimulus controller flips `hidden` on
      success of /vehicles/lookup and fills in the patente + meta. %>
  <div class="wof-banner hidden" data-vehicle-lookup-target="banner">
    <span class="wof-banner-icon">
      <span class="material-symbols-outlined" style="font-size:16px">check</span>
    </span>
    <div class="flex-1 min-w-0">
      <div class="wof-banner-title">
        <%= t(".banner_title") %> ·
        <span class="wof-mono" data-vehicle-lookup-target="bannerPatente"></span>
      </div>
      <div class="wof-banner-meta" data-vehicle-lookup-target="bannerMeta"></div>
    </div>
  </div>

  <%# ── 01 · Datos del vehículo ────────────────────────────────── %>
  <div class="wof-section">
    <span class="wof-section-icon">
      <span class="material-symbols-outlined" style="font-size:15px">directions_car</span>
    </span>
    <span class="wof-section-name"><%= t(".section.vehicle") %></span>
    <span class="wof-section-rule"></span>
    <span class="wof-section-num">01</span>
  </div>

  <div class="wof-grid-2">
    <%# Patente — autocompletes the rest of the vehicle fields via Stimulus %>
    <div>
      <div class="wof-label-row">
        <%= f.label :patente, class: "wof-label" %>
        <span class="wof-hint"><%= t(".hint.autocomplete") %></span>
      </div>
      <div class="wof-input-wrap wof-mono">
        <%= f.text_field :patente,
                         value: work_order.patente || work_order.vehicle&.patente,
                         placeholder: t(".patente_placeholder"),
                         autofocus: true,
                         data: {
                           vehicle_lookup_target: "patente",
                           action: "change->vehicle-lookup#fetch"
                         } %>
      </div>
    </div>

    <%# Kilometraje %>
    <div>
      <div class="wof-label-row">
        <%= f.label :mileage, class: "wof-label" %>
      </div>
      <div class="wof-input-wrap">
        <%= f.number_field :mileage,
                           min: 0,
                           placeholder: t(".mileage_placeholder") %>
        <span class="wof-input-suffix"><%= t("work_orders.show.mileage_unit") %></span>
      </div>
    </div>

    <%# Marca %>
    <div>
      <div class="wof-label-row">
        <%= f.label :make, class: "wof-label" %>
      </div>
      <div class="wof-input-wrap">
        <%= f.text_field :make,
                         placeholder: t(".make_placeholder"),
                         data: { vehicle_lookup_target: "make" } %>
      </div>
    </div>

    <%# Modelo %>
    <div>
      <div class="wof-label-row">
        <%= f.label :model, class: "wof-label" %>
      </div>
      <div class="wof-input-wrap">
        <%= f.text_field :model,
                         placeholder: t(".model_placeholder"),
                         data: { vehicle_lookup_target: "model" } %>
      </div>
    </div>

    <%# Año %>
    <div>
      <div class="wof-label-row">
        <%= f.label :year, class: "wof-label" %>
      </div>
      <div class="wof-input-wrap wof-mono">
        <%= f.number_field :year,
                           min: 1950,
                           max: Date.current.year + 1,
                           placeholder: t(".year_placeholder"),
                           data: { vehicle_lookup_target: "year" } %>
      </div>
    </div>
  </div>

  <%# ── 02 · Cliente ───────────────────────────────────────────── %>
  <div class="wof-section">
    <span class="wof-section-icon">
      <span class="material-symbols-outlined" style="font-size:15px">person</span>
    </span>
    <span class="wof-section-name"><%= t(".section.customer") %></span>
    <span class="wof-section-rule"></span>
    <span class="wof-section-num">02</span>
  </div>

  <div class="wof-grid-2-stack">
    <div class="wof-label-row">
      <%= f.label :customer_name, class: "wof-label" %>
    </div>
    <div class="wof-input-wrap">
      <%= f.text_field :customer_name,
                       placeholder: t(".customer_name_placeholder"),
                       data: { vehicle_lookup_target: "customerName" } %>
    </div>
  </div>

  <%# ── 03 · Motivo de ingreso ──────────────────────────────────── %>
  <div class="wof-section">
    <span class="wof-section-icon">
      <span class="material-symbols-outlined" style="font-size:15px">edit_note</span>
    </span>
    <span class="wof-section-name"><%= t(".section.reason") %></span>
    <span class="wof-section-rule"></span>
    <span class="wof-section-num">03</span>
  </div>

  <div class="wof-grid-2-stack">
    <div class="wof-input-wrap wof-textarea-wrap">
      <%= f.text_area :reason,
                      rows: 4,
                      placeholder: t(".reason_placeholder") %>
    </div>
    <p class="wof-motivo-hint">
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">bolt</span>
      <%= t(".reason_hint") %>
    </p>
  </div>

  <%# ── 04 · Fotos del vehículo · opcional ──────────────────────── %>
  <div class="wof-section">
    <span class="wof-section-icon">
      <span class="material-symbols-outlined" style="font-size:15px">photo_camera</span>
    </span>
    <span class="wof-section-name"><%= t(".section.photos") %></span>
    <span class="wof-section-rule"></span>
    <span class="wof-section-num">04</span>
  </div>

  <%# Hidden file_field + clickable label wrapping the dropzone visuals.
      The whole zone opens the picker because <label[for]> targets the
      input. No JS overlay needed. %>
  <label for="work_order_photos" class="wof-drop">
    <span class="material-symbols-outlined" style="font-size:22px">add_a_photo</span>
    <span class="wof-drop-title">
      <%= t(".upload.title") %>
      <br>
      <span class="wof-drop-meta"><%= t(".upload.subtitle") %></span>
    </span>
  </label>
  <%= f.file_field :photos, multiple: true, accept: "image/*", class: "hidden" %>

  <%# ── Divider + actions ───────────────────────────────────────── %>
  <div class="wof-divider"></div>
  <div class="wof-actions">
    <div class="flex-1"></div>
    <%= link_to t(".cancel"), work_orders_path, class: "wof-cancel" %>
    <%= f.button class: "wof-submit" do %>
      <%= t("helpers.submit.work_order.#{work_order.persisted? ? 'update' : 'create'}") %>
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">bolt</span>
    <% end %>
  </div>
<% end %>
