<%# State-aware container for the AI analysis section. Wrapped in a div
    with a stable ID so the AnalyzeWorkOrderJob can broadcast updates to
    it via Turbo Streams without a page refresh. Each state has its own
    enter animation so re-analyzing feels like a transformation, not a
    page reload. %>
<div id="<%= dom_id(work_order, :analysis) %>">
  <% case work_order.status %>
  <% when "analyzing" %>
    <div class="flex flex-col items-center justify-center py-12 space-y-3 animate-fade-in-up">
      <div class="relative">
        <%# Soft outer pulse ring + a faster inner spinner for visual layering. %>
        <div class="absolute inset-0 rounded-full bg-indigo-200 animate-ping opacity-50"></div>
        <svg class="relative animate-spin h-10 w-10 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
          <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      </div>
      <p class="text-sm text-zinc-700 font-medium"><%= t("work_orders.show.ai_analysis_in_progress") %></p>
      <p class="text-xs text-zinc-400"><%= t("work_orders.show.ai_analysis_in_progress_hint") %></p>
    </div>
  <% else %>
    <% if work_order.ai_analysis %>
      <div class="animate-fade-in-up">
        <%= render "stats_strip", work_order: work_order %>
        <%= render "ai_analysis", work_order: work_order %>
      </div>
    <% else %>
      <p class="text-sm text-zinc-600 italic"><%= t("work_orders.show.ai_analysis_pending") %></p>
    <% end %>
  <% end %>
</div>
