<%# State-aware container for the AI analysis section. Wrapped in a div
    with a stable ID so AnalyzeWorkOrderJob can broadcast updates via
    Turbo Streams without a page refresh. Garage dark theme: tokens come
    from .wof CSS vars (set on the wrapping .wof in show.html.erb). %>
<div id="<%= dom_id(work_order, :analysis) %>">
  <% case work_order.status %>
  <% when "analyzing" %>
    <section class="wof-card animate-fade-in-up" style="margin-bottom: 24px;">
      <div class="flex flex-col items-center justify-center py-16 gap-3">
        <div class="relative">
          <div class="absolute inset-0 rounded-full animate-ping opacity-50" style="background: var(--wof-accent);"></div>
          <svg class="relative animate-spin h-10 w-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" style="color: var(--wof-accent);">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
        </div>
        <p style="font-size: 18px; font-weight: 700; color: var(--wof-ink);"><%= t("work_orders.show.ai_analysis_in_progress") %></p>
        <p style="font-size: 13.5px; color: var(--wof-muted);"><%= t("work_orders.show.ai_analysis_in_progress_hint") %></p>
      </div>
    </section>
  <% else %>
    <% if work_order.ai_analysis %>
      <div class="animate-fade-in-up">
        <%# Absolute partial path so Turbo Stream broadcasts (which render
            this partial without a controller context) can find the inner
            partial. Relative "ai_analysis" only resolves when there's a
            wrapping controller — broadcasts don't have one. %>
        <%= render "work_orders/ai_analysis", work_order: work_order %>
      </div>
    <% else %>
      <section class="wof-card" style="margin-bottom: 24px;">
        <h2 class="wof-label" style="margin-bottom: 8px;"><%= t("work_orders.show.ai_analysis_heading") %></h2>
        <p style="font-size: 13.5px; color: var(--wof-muted); font-style: italic;"><%= t("work_orders.show.ai_analysis_pending") %></p>
      </section>
    <% end %>
  <% end %>
</div>
