<%# Renders the structured AI analysis for a WorkOrder — Garage dark theme.
    Tokens come from .wof CSS vars set by the wrapping .wof div in show. %>
<% analysis = work_order.ai_analysis %>
<% next_steps_sorted = (analysis.next_steps.presence || []).sort_by { |s| s["order"].to_i } %>
<% confidence_degrees = (analysis.confidence.to_f * 360).round %>
<% donut_color = confidence_color_var(analysis) %>

<div class="grid grid-cols-12 gap-6">
  <%# ═══════════════ LEFT COLUMN (col-span-8) ═══════════════ %>
  <div class="col-span-12 lg:col-span-8 space-y-6">

    <%# ── AI Analysis Card ───────────────────────────────────── %>
    <article class="wof-card relative overflow-hidden"
             style="background: linear-gradient(135deg, var(--wof-panel), #141A22); display: flex; flex-direction: column; gap: 24px;">
      <%# Decorative blurred halo in the top-right corner %>
      <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full blur-3xl pointer-events-none"
           style="background: var(--wof-accent-soft);"></div>

      <div class="flex flex-col md:flex-row gap-6 relative z-10">
        <%# Confidence donut ─────────────────────────────────── %>
        <% if analysis.confidence.present? %>
          <div class="flex flex-col items-center justify-center flex-shrink-0">
            <div class="relative w-32 h-32 rounded-full"
                 style="background: conic-gradient(<%= donut_color %> <%= confidence_degrees %>deg, var(--wof-field-bg) 0deg);">
              <div class="absolute inset-2 rounded-full flex flex-col items-center justify-center"
                   style="background: var(--wof-panel);">
                <span style="font-size: 30px; font-weight: 700; line-height: 1; color: <%= donut_color %>;"><%= confidence_percentage(analysis) %>%</span>
                <span class="wof-label" style="margin-top: 4px;"><%= t(".confidence_label") %></span>
              </div>
            </div>
          </div>
        <% end %>

        <%# Diagnosis content ──────────────────────────────────── %>
        <div class="flex-1 min-w-0" style="display: flex; flex-direction: column; gap: 10px;">
          <%# Top row: category pill + review banner %>
          <div class="flex justify-between items-center gap-2 flex-wrap">
            <span class="wof-mono"
                  style="font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; background: var(--wof-accent-soft); color: var(--wof-accent); border: 1px solid rgba(194,249,78,0.3);">
              <%= category_label(analysis.category) %>
            </span>
            <% if analysis.requires_human_review %>
              <div class="flex items-center gap-2"
                   style="padding: 5px 12px; border-radius: 999px; background: rgba(255,118,118,0.12); color: var(--wof-danger); border: 1px solid rgba(255,118,118,0.35);">
                <span class="material-symbols-outlined" style="font-size: 16px; font-variation-settings: 'FILL' 1;">warning</span>
                <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;"><%= t(".review_banner_title") %></span>
              </div>
            <% end %>
          </div>

          <h3 style="font-size: 20px; font-weight: 700; color: var(--wof-accent); letter-spacing: -0.3px; margin: 0;">
            <%= t(".diagnosis_heading") %>
          </h3>

          <% if analysis.priority_reason.present? %>
            <p style="font-size: 14.5px; color: var(--wof-ink-soft); line-height: 1.55; margin: 0;">
              <%= analysis.priority_reason %>
            </p>
          <% end %>
        </div>
      </div>
    </article>

    <%# ── Stats row (subtle, below the AI card) ────────────── %>
    <% if work_order.agent_runs.any? %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1"
           style="font-size: 13px; color: var(--wof-muted);">
        <span><strong style="color: var(--wof-ink);"><%= number_with_delimiter(work_order.ai_total_tokens) %></strong> <%= t(".stats_tokens") %></span>
        <span aria-hidden="true">·</span>
        <span><strong style="color: var(--wof-ink);"><%= format_cents(work_order.ai_total_cost_cents) %></strong> <%= t(".stats_cost") %></span>
        <span aria-hidden="true">·</span>
        <span><strong style="color: var(--wof-ink);"><%= work_order.agent_runs.size %></strong> <%= t(".stats_runs", count: work_order.agent_runs.size) %></span>
      </div>
    <% end %>

    <%# ── Posibles fallas ───────────────────────────────────── %>
    <% if analysis.possible_failures.present? && analysis.possible_failures.any? %>
      <section>
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h2 style="font-size: 22px; font-weight: 700; color: var(--wof-ink); letter-spacing: -0.4px; margin: 0;"><%= t(".possible_failures_heading") %></h2>
          <span style="font-size: 13px; color: var(--wof-muted);">
            <%= t(".failures_count", count: analysis.possible_failures.size) %>
          </span>
        </div>
        <div class="space-y-4">
          <% analysis.possible_failures.each_with_index do |failure, i| %>
            <% muted = failure["probability"] == "low" ? "opacity-70 hover:opacity-100 transition-opacity" : "" %>
            <div class="wof-failure-card flex gap-4 <%= muted %>">
              <div class="w-10 h-10 shrink-0 <%= probability_circle_class(failure["probability"]) %> rounded-full flex items-center justify-center font-bold">
                <%= i + 1 %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-start mb-1.5 gap-3">
                  <h4 style="font-size: 16px; font-weight: 700; color: var(--wof-ink); flex: 1; min-width: 0; margin: 0; line-height: 1.35;">
                    <%= failure["component"] %>
                  </h4>
                  <span class="<%= probability_label_color(failure["probability"]) %> flex-shrink-0"
                        style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding-top: 2px;">
                    <%= probability_label(failure["probability"]) %>
                  </span>
                </div>
                <% if failure["reasoning"].present? %>
                  <p style="font-size: 13.5px; color: var(--wof-muted); line-height: 1.5; margin: 0;"><%= failure["reasoning"] %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <%# ═══════════════ RIGHT COLUMN (col-span-4) ═══════════════ %>
  <div class="col-span-12 lg:col-span-4 space-y-6">

    <%# ── Próximos Pasos card (first 4 + "Ver guía completa" modal) ── %>
    <% if next_steps_sorted.any? %>
      <div class="wof-card" data-controller="full-steps-modal">
        <h2 class="flex items-center gap-2"
            style="font-size: 18px; font-weight: 700; color: var(--wof-ink); margin: 0 0 20px;">
          <span class="material-symbols-outlined" style="color: var(--wof-accent);">assignment_turned_in</span>
          <%= t(".next_steps_heading") %>
        </h2>
        <div class="space-y-5">
          <% next_steps_sorted.first(4).each do |step| %>
            <div class="flex gap-4">
              <span class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shrink-0"
                    style="background: var(--wof-accent-soft); color: var(--wof-accent); border: 1px solid rgba(194,249,78,0.3);">
                <%= step["order"] %>
              </span>
              <div class="space-y-1.5 min-w-0">
                <p style="font-size: 13.5px; color: var(--wof-ink-soft); line-height: 1.45; margin: 0;"><%= step["action"] %></p>
                <% if step["required_tool"].present? %>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="wof-mono" style="font-size: 10px; font-weight: 700; color: var(--wof-faint); text-transform: uppercase; letter-spacing: 1.2px;"><%= t(".required_tool_prefix") %>:</span>
                    <span class="wof-mono"
                          style="font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px; background: var(--wof-field-bg); color: var(--wof-accent); border: 1px solid var(--wof-field-line); text-transform: uppercase; letter-spacing: 0.5px;">
                      <%= step["required_tool"] %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if next_steps_sorted.size > 4 %>
          <button type="button"
                  data-action="click->full-steps-modal#open"
                  class="block w-full mt-6 transition-colors cursor-pointer"
                  style="border: 2px solid var(--wof-accent); color: var(--wof-accent); background: transparent; padding: 10px; border-radius: 12px; font-weight: 700; font-size: 13.5px; text-align: center;">
            <%= t(".full_guide_button", count: next_steps_sorted.size) %>
          </button>

          <%# Full steps timeline — rendered inside a native <dialog>. The
              modal keeps a dark Garage palette via inline styles + nested
              .wof selectors so it matches the rest of the page. %>
          <dialog data-full-steps-modal-target="dialog"
                  data-action="click->full-steps-modal#backdropClick"
                  class="w-[92vw] max-w-3xl max-h-[90vh] rounded-xl p-0 m-auto backdrop:backdrop-blur-sm"
                  style="background: var(--wof-panel); border: 1px solid var(--wof-panel-line); color: var(--wof-ink);">
            <div class="flex flex-col max-h-[90vh] wof">
              <header class="flex justify-between items-start px-6 py-5 sticky top-0 z-10"
                      style="background: var(--wof-panel); border-bottom: 1px solid var(--wof-panel-line);">
                <div>
                  <h1 style="font-size: 22px; font-weight: 700; color: var(--wof-ink); margin: 0; letter-spacing: -0.3px;">
                    <%= t(".full_steps_heading") %>
                  </h1>
                  <div class="flex items-center gap-2 mt-1.5">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--wof-accent); font-variation-settings: 'FILL' 1;">smart_toy</span>
                    <p style="font-size: 13px; color: var(--wof-muted); margin: 0;">
                      <%= t(".full_steps_subtitle_html",
                             count: next_steps_sorted.size,
                             patente: work_order.vehicle.patente) %>
                    </p>
                  </div>
                </div>
                <button type="button"
                        data-action="click->full-steps-modal#close"
                        aria-label="<%= t("work_orders.show.agent_runs_modal_close") %>"
                        class="p-2 rounded-full transition-colors cursor-pointer"
                        style="color: var(--wof-muted); background: var(--wof-field-bg);">
                  <span class="material-symbols-outlined">close</span>
                </button>
              </header>

              <ol class="flex-1 overflow-y-auto px-6 py-6 space-y-6" style="background: var(--wof-app-bg);">
                <% next_steps_sorted.each_with_index do |step, i| %>
                  <% is_first = (i == 0) %>
                  <% is_last = (i == next_steps_sorted.size - 1) %>
                  <% title, desc = split_step_action(step["action"]) %>
                  <li class="relative flex items-center gap-6 <%= 'step-line-top' unless is_first %> <%= 'step-line-bottom' unless is_last %>">
                    <div class="z-10 flex-none w-10 h-10 rounded-full flex items-center justify-center font-bold text-base shadow-md"
                         style="background: var(--wof-accent); color: var(--wof-accent-ink);">
                      <%= step["order"] %>
                    </div>

                    <article class="flex-1 min-w-0 rounded-xl p-5 transition-all"
                             style="background: var(--wof-panel); border: 1px solid var(--wof-panel-line);">
                      <% if title.present? %>
                        <h3 style="font-size: 16px; font-weight: 700; color: var(--wof-ink); margin: 0 0 8px;">
                          <%= title %>
                        </h3>
                      <% end %>
                      <p style="font-size: 14px; color: var(--wof-ink-soft); line-height: 1.55; margin: 0; <%= 'margin-bottom: 16px;' if step['required_tool'].present? %>">
                        <%= desc %>
                      </p>

                      <% if step["required_tool"].present? %>
                        <% tools = step["required_tool"].split(/\s*[,;]\s*/).reject(&:blank?) %>
                        <div class="flex flex-wrap gap-2 pt-3" style="border-top: 1px solid var(--wof-panel-line);">
                          <% tools.each do |tool| %>
                            <span class="inline-flex items-center gap-1.5"
                                  style="padding: 4px 12px; border-radius: 999px; background: var(--wof-field-bg); color: var(--wof-ink-soft); font-size: 12px; font-weight: 600; border: 1px solid var(--wof-field-line);">
                              <span class="material-symbols-outlined" style="font-size: 14px; color: var(--wof-accent);">handyman</span>
                              <%= tool %>
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </article>
                  </li>
                <% end %>
              </ol>
            </div>
          </dialog>
        <% end %>
      </div>
    <% end %>

    <%# ── Observaciones del Registro ─────────────────────────── %>
    <% if analysis.observations.present? %>
      <div class="wof-card">
        <h3 class="wof-label" style="margin-bottom: 14px;"><%= t(".observations_heading") %></h3>
        <div style="background: var(--wof-field-bg); border: 1px solid var(--wof-field-line); border-radius: 10px; padding: 14px; font-size: 13px; color: var(--wof-ink-soft); font-style: italic; line-height: 1.5;">
          "<%= analysis.observations %>"
        </div>
        <% if (run = work_order.latest_agent_run) %>
          <div class="mt-4 flex items-center justify-end">
            <span class="wof-mono" style="font-size: 11px; color: var(--wof-faint);">
              <%= t(".registered_by_html", model: tag.code(run.ai_model, class: "wof-mono", style: "color: var(--wof-accent);")) %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# ═══════════════ Retrieval observability panel ═══════════════ %>
<%= render "work_orders/retrieval_runs", work_order: work_order %>

<%# ═══════════════ Sources (RAG citations) ═══════════════
     Cada source se renderiza como una card con el código DTC destacado.
     El badge del DTC es el "anchor" visual — refuerza que el análisis
     está grounded en documentación real. %>
<% if analysis.sources.present? && analysis.sources.any? %>
  <section class="wof-card mt-6" style="overflow: hidden; padding: 0;">
    <header class="flex items-center gap-2 px-6 py-4" style="background: var(--wof-app-bg); border-bottom: 1px solid var(--wof-panel-line);">
      <span class="material-symbols-outlined" style="color: var(--wof-accent); font-size: 20px;">menu_book</span>
      <h2 style="font-size: 16px; font-weight: 700; color: var(--wof-ink); margin: 0;"><%= t(".sources_heading") %></h2>
      <span class="wof-mono"
            style="margin-left: auto; font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; background: var(--wof-field-bg); color: var(--wof-muted); border: 1px solid var(--wof-field-line);">
        <%= analysis.sources.size %> <%= analysis.sources.size == 1 ? "cita" : "citas" %>
      </span>
    </header>
    <ul style="margin: 0; padding: 0; list-style: none;">
      <% analysis.sources.each_with_index do |source, i| %>
        <li class="px-6 py-4" style="<%= 'border-top: 1px solid var(--wof-panel-line);' if i > 0 %>">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <% if source["dtc_code"].present? %>
              <span class="wof-mono"
                    style="font-size: 11.5px; font-weight: 700; letter-spacing: 0.8px; padding: 4px 10px; border-radius: 6px; background: var(--wof-accent-soft); color: var(--wof-accent); border: 1px solid rgba(194,249,78,0.3);">
                <%= source["dtc_code"] %>
              </span>
            <% end %>
            <span style="font-weight: 600; color: var(--wof-ink); font-size: 13.5px;">
              <%= source["document_title"] %>
            </span>
            <span style="color: var(--wof-muted); font-size: 12.5px;">
              · pág. <%= source["page"] %>
            </span>
          </div>
          <% if source["relevant_excerpt"].present? %>
            <p style="color: var(--wof-ink-soft); margin: 0; font-style: italic; font-size: 13px; line-height: 1.5; padding-left: 12px; border-left: 2px solid var(--wof-field-line);">
              "<%= source["relevant_excerpt"] %>"
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
