<%# Aggregated AI usage stats across every AnalyzeWorkOrderJob attempt for
    this OT. Sits at the top of the AI analysis section so the operator
    sees at a glance "how much AI work has gone into this case" before
    diving into the diagnostic detail. %>
<% return if work_order.agent_runs.empty? %>

<div class="bg-zinc-100 border border-zinc-200 rounded-md px-4 py-2 mb-4 flex items-center gap-3 text-xs text-zinc-600 flex-wrap">
  <span>
    <strong class="text-zinc-900"><%= number_with_delimiter(work_order.ai_total_tokens) %></strong>
    <%= t(".tokens") %>
  </span>
  <span aria-hidden="true" class="text-zinc-300">•</span>
  <span>
    <strong class="text-zinc-900"><%= format_cents(work_order.ai_total_cost_cents) %></strong>
  </span>
  <span aria-hidden="true" class="text-zinc-300">•</span>
  <span>
    <strong class="text-zinc-900"><%= work_order.agent_runs.size %></strong>
    <%= t(".runs", count: work_order.agent_runs.size) %>
  </span>
  <% if work_order.last_agent_run_at %>
    <span aria-hidden="true" class="text-zinc-300">•</span>
    <span><%= t(".last_run") %>: <%= l(work_order.last_agent_run_at, format: :short) %></span>
  <% end %>
</div>
