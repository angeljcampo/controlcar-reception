<%# Recepción · Nueva Orden de Trabajo
    Dark "Garage" theme (Claude Design handoff). Self-contained inside
    .wof — the rest of the app (work_orders#index, #show) keeps the
    light MD3 theme. Tokens live in app/assets/tailwind/application.css. %>
<div class="wof">
  <div class="wof-page">
    <div class="wof-container">

      <%# Header ─ back link + title + folio chip ─────────────────── %>
      <div class="wof-header">
        <div class="flex-1">
          <%= link_to work_orders_path, class: "wof-back" do %>
            <span class="material-symbols-outlined" style="font-size:15px">arrow_back</span>
            <%= t(".back").to_s.upcase %>
          <% end %>
          <h1 class="wof-title"><%= t(".title") %></h1>
          <p class="wof-subtitle"><%= t(".subtitle") %></p>
        </div>
        <div class="wof-folio">
          <span class="wof-folio-label"><%= t(".folio_label") %></span>
          <span class="wof-folio-value"><%= t(".folio_draft") %></span>
        </div>
      </div>

      <%# Form card ───────────────────────────────────────────────── %>
      <div class="wof-card">
        <%= render "form", work_order: @work_order %>
      </div>

    </div>
  </div>
</div>
