<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-900">Órdenes de trabajo</h1>
      <p class="text-sm text-zinc-500 mt-1">Recepción y diagnóstico inteligente de vehículos</p>
    </div>
    <%= link_to "Nueva OT",
                new_work_order_path,
                class: "inline-flex items-center px-4 py-2 rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm" %>
  </div>

  <% if @work_orders.empty? %>
    <div class="bg-white rounded-lg border border-zinc-200 p-12 text-center">
      <p class="text-zinc-500">Aún no hay órdenes de trabajo registradas.</p>
      <%= link_to "Crear la primera",
                  new_work_order_path,
                  class: "inline-block mt-4 text-indigo-600 hover:text-indigo-700 font-medium" %>
    </div>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @work_orders.each do |wo| %>
        <%= link_to work_order_path(wo),
                    class: "block bg-white rounded-lg border border-zinc-200 shadow-sm hover:shadow-md hover:border-zinc-300 transition p-5" do %>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-lg font-semibold text-zinc-900"><%= wo.vehicle.patente %></span>
            <%= status_badge(wo) %>
          </div>
          <p class="text-sm text-zinc-700 mb-3"><%= wo.customer_name %></p>
          <p class="text-sm text-zinc-500 line-clamp-2 mb-3"><%= wo.reason %></p>
          <div class="flex items-center justify-between text-xs text-zinc-400">
            <%= priority_badge(wo) %>
            <span><%= l(wo.created_at, format: :short) rescue wo.created_at.strftime("%d/%m %H:%M") %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
