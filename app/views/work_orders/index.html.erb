<%# Listado de Órdenes — Garage dark theme.
    Misma paleta y tipografía que /work_orders/new (.wof tokens en
    application.css). Cards oscuras con borde tenue y hover en lima. %>
<div class="wof">
  <div class="wof-page" style="padding-top: 34px;">
    <div class="wof-container" style="max-width: 1200px;">

      <%# Header: title + new-OT button ───────────────────────────── %>
      <div class="wof-index-header">
        <div>
          <h1 class="wof-title"><%= t(".title") %></h1>
          <p class="wof-subtitle"><%= t(".subtitle") %></p>
        </div>
        <%= link_to new_work_order_path, class: "wof-submit", style: "min-width: 0; padding: 0 22px; text-decoration: none;" do %>
          <span class="material-symbols-outlined" style="font-size:18px">add</span>
          <%= t(".new_button") %>
        <% end %>
      </div>

      <%# Empty state ─────────────────────────────────────────────── %>
      <% if @work_orders.empty? %>
        <div class="wof-card" style="text-align: center; padding: 56px 30px;">
          <div style="display:inline-flex; width:56px; height:56px; border-radius:14px; background:var(--wof-accent-soft); color:var(--wof-accent); align-items:center; justify-content:center; margin-bottom:18px;">
            <span class="material-symbols-outlined" style="font-size:28px">inbox</span>
          </div>
          <p style="color: var(--wof-ink-soft); font-size: 15px; margin: 0 0 18px;">
            <%= t(".empty.message") %>
          </p>
          <%= link_to t(".empty.cta"), new_work_order_path,
                      class: "wof-submit",
                      style: "display: inline-flex; min-width: 0; padding: 0 22px; text-decoration: none;" %>
        </div>
      <% else %>

        <%# Grid of work order cards ─────────────────────────────── %>
        <div class="wof-grid">
          <% @work_orders.each do |wo| %>
            <%= link_to work_order_path(wo), class: "wof-list-card" do %>
              <%# Top row: patente (mono) + status pill %>
              <div class="wof-list-top">
                <span class="wof-list-patente wof-mono"><%= wo.vehicle.patente %></span>
                <%= status_badge(wo) %>
              </div>

              <%# Vehicle line if make/model exist %>
              <% if wo.vehicle.make.present? || wo.vehicle.model.present? %>
                <p class="wof-list-vehicle">
                  <%= [wo.vehicle.make, wo.vehicle.model, wo.vehicle.year].compact.join(" ") %>
                </p>
              <% end %>

              <%# Customer name %>
              <p class="wof-list-customer"><%= wo.customer_name %></p>

              <%# Reason (truncated) %>
              <p class="wof-list-reason"><%= wo.reason %></p>

              <%# Footer: priority pill + date %>
              <div class="wof-list-footer">
                <%= priority_badge(wo) %>
                <span class="wof-list-date wof-mono"><%= l(wo.created_at, format: :short) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
