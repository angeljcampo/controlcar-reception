<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t(".full_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts: Hanken Grotesk for headlines, Inter for body, plus
        Material Symbols Outlined for icons. preconnect speeds up TLS. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet">
    <%# Space Grotesk + JetBrains Mono — used by the dark "Garage" theme on
        /work_orders/new (see .wof CSS in application.css). %>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background min-h-screen text-on-surface antialiased font-body">
    <header class="bg-surface-container-lowest border-b border-outline-variant">
      <div class="flex justify-between items-center w-full px-6 h-16 max-w-[1400px] mx-auto">
        <%= link_to root_path, class: "flex items-center gap-4 text-on-surface hover:text-primary transition-colors" do %>
          <span class="font-headline text-headline-sm font-bold"><%= t(".app_short") %></span>
          <span class="text-on-surface-variant text-label-md hidden md:inline"><%= t(".app_tagline") %></span>
        <% end %>

        <nav class="hidden md:flex items-center gap-8">
          <% nav_link_classes = "text-label-md font-medium transition-colors pb-1" %>
          <%= link_to t(".nav.work_orders"),
                      work_orders_path,
                      class: "#{nav_link_classes} #{current_page?(work_orders_path) || controller_name == "work_orders" ? "text-primary border-b-2 border-primary font-bold" : "text-on-surface-variant hover:text-primary"}" %>
          <%= link_to "Knowledge Base",
                      knowledge_documents_path,
                      class: "#{nav_link_classes} #{controller_name == "knowledge_documents" ? "text-primary border-b-2 border-primary font-bold" : "text-on-surface-variant hover:text-primary"}" %>
        </nav>
      </div>
    </header>

    <%# Flash messages — Garage dark theme. Notice = lime translucid,
        alert = red translucid. Same tokens as the rest of the work_order
        views so the strip blends with the dark background instead of
        flashing a light-mode banner over a dark page. %>
    <% if flash[:notice] || flash[:alert] %>
      <div style="background: #0A0D12;">
        <div class="max-w-[1400px] mx-auto px-6 pt-4">
          <% if flash[:notice] %>
            <div class="flex items-center gap-3 rounded-lg px-4 py-3 text-body-sm"
                 style="background: rgba(194, 249, 78, 0.10); border: 1px solid rgba(194, 249, 78, 0.30); color: #DDF8A0;">
              <span class="material-symbols-outlined" style="font-size: 20px; color: #C2F94E;">check_circle</span>
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="flex items-center gap-3 rounded-lg px-4 py-3 text-body-sm"
                 style="background: rgba(255, 118, 118, 0.10); border: 1px solid rgba(255, 118, 118, 0.30); color: #FFB3B3;">
              <span class="material-symbols-outlined" style="font-size: 20px; color: #FF7676;">error</span>
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="bg-surface mt-8 border-t border-outline-variant">
      <div class="flex flex-col md:flex-row justify-between items-center py-4 px-6 w-full max-w-[1400px] mx-auto gap-4">
        <div class="flex items-center gap-2">
          <span class="text-label-md font-semibold text-secondary"><%= t(".app_short") %></span>
          <span class="text-body-sm text-on-tertiary-fixed-variant">© <%= Date.current.year %> <%= t(".footer_tagline") %></span>
        </div>
        <div class="flex gap-6">
          <a class="text-label-md text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#"><%= t(".footer.support") %></a>
          <a class="text-label-md text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#"><%= t(".footer.docs") %></a>
          <a class="text-label-md text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#"><%= t(".footer.privacy") %></a>
        </div>
      </div>
    </footer>
  </body>
</html>
